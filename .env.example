# Copy to .env and replace the token: openssl rand -hex 16
YT_API_TOKEN=change-me
YT_API_PORT=8099
#YT_API_HOST=127.0.0.1
#YT_PUBLIC_READ=1
# Where the XML feeds are served (nginx in prod, http.server locally)
#YT_FEEDS_PUBLIC_BASE=http://localhost:8001
#YT_LANG=en
#YT_KINDS=videos
#YT_MAX_ITEMS=20

# --- CORS ---------------------------------------------------------------
# "*" allows any browser origin; use a comma list to restrict, empty to disable.
#YT_CORS_ORIGINS=*
#YT_CORS_ORIGINS=https://app.example.com

# --- Docker / Render ----------------------------------------------------
# YT_SERVE_FEEDS=1 also serves feeds/*.xml at /feeds/ from api.py (one port).
#YT_SERVE_FEEDS=0
# Re-harvest every N seconds inside the API process (0 disables; containers have no cron).
#YT_REFRESH_INTERVAL=0
# Public prefix for docker compose (RSS self-links and feed_url).
#YT_PUBLIC_BASE=https://feeds.example.com
